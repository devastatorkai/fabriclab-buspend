    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "783825de-84ef-4b4d-b452-21d6a471157a"
      },
      "text": "BUSpend\r\n| extend ts = todatetime(timestamp)\r\n| make-series total_spend = sum(transaction_amount) on ts from ago(30d) to now() step 1d by business_unit\r\n| extend (anomalies, score, baseline) = series_decompose_anomalies(total_spend, 1.5, -1, 'linefit')",
      "id": "152a1528-f897-4edb-a766-f14578ea681c",
